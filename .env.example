PORT=3001
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=zhino_app

# MySQL credentials above are written by the web installer (step 1).
# The server never auto-creates the database from .env on startup —
# open the site and complete the 3-step installer wizard first.
# After success, a `.installed` lock file is created.

# --- System updates (optional, for future remote version checks) ---
# JSON manifest URL, e.g. https://updates.example.com/zhino/manifest.json
# ZHINO_UPDATE_URL=
# Optional bearer token for private manifests
# ZHINO_UPDATE_TOKEN=
# Set to 1 only when a secure apply runner is configured on the server
# ZHINO_UPDATE_APPLY=0
