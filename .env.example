PORT=3001
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=zhino_app

# MySQL credentials above are written by the web installer (step 1).
# The server never auto-creates the database from .env on startup —
# open the site and complete the 3-step installer wizard first.
# After success, a `.installed` lock file is created.

# --- CLI / MCP API access ---
# When set, POST/PUT/PATCH/DELETE on /api require this token
# (Authorization: Bearer … or X-Zhino-Token). GETs stay public.
# ZHINO_API_TOKEN=
# Base URL for `npm run zhino` / MCP (default http://127.0.0.1:3001)
# ZHINO_API_BASE=http://127.0.0.1:3001
# Same token for admin UI writes via Vite (optional; only needed if ZHINO_API_TOKEN is set)
# VITE_ZHINO_API_TOKEN=

# --- System updates (git preferred when the install is a clone) ---
# Default: check/apply via git fetch + fast-forward pull from upstream.
# ZHINO_UPDATE_GIT_REMOTE=origin
# ZHINO_UPDATE_GIT_BRANCH=main
# Set to 1 to allow POST /api/system/updates/apply to run git pull
# ZHINO_UPDATE_APPLY=0
# Optional shell command after a successful pull (default: npm install && npm run build)
# ZHINO_UPDATE_POST_PULL=npm install && npm run build
# ZHINO_UPDATE_SKIP_BUILD=0
# Allow pull when the working tree has local changes (dangerous)
# ZHINO_UPDATE_ALLOW_DIRTY=0
# Force legacy JSON manifest mode instead of git:
# ZHINO_UPDATE_METHOD=manifest
# ZHINO_UPDATE_URL=
# ZHINO_UPDATE_TOKEN=
